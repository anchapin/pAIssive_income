name: Python Test Coverage

on:
  push:
    branches: [ main, dev, master, develop, fix/test-coverage-15-percent ]
    paths:
      - '**/*.py'
      - 'requirements*.txt'
      - 'pyproject.toml'
      - 'pytest.ini'
      - '.github/workflows/python-coverage.yml'
  pull_request:
    branches: [ main, dev, master, develop, fix/test-coverage-15-percent ]
    paths:
      - '**/*.py'
      - 'requirements*.txt'
      - 'pyproject.toml'
      - 'pytest.ini'
      - '.github/workflows/python-coverage.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  CI: true
  CI_ENVIRONMENT: true
  PYTHONPATH: ${{ github.workspace }}

jobs:
  python-coverage:
    name: Python Coverage Check
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Cache uv dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.cache/uv
            ~/.uv
            .pytest_cache
          key: ${{ runner.os }}-uv-coverage-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-uv-coverage-

      - name: Install uv
        run: |
          curl -LsSf https://astral.sh/uv/0.5.4/install.sh | sh
          echo "$HOME/.cargo/bin" >> $GITHUB_PATH

      - name: Install dependencies
        run: |
          # Create virtual environment with uv (with fallback)
          uv venv .venv || {
            echo "uv venv failed. Falling back to Python's built-in venv..."
            python -m venv .venv
          }
          source .venv/bin/activate

          # Install test dependencies
          uv pip install pytest pytest-cov pytest-xdist pytest-asyncio

          # Install development dependencies (includes sqlalchemy and other test requirements)
          if [ -f requirements-dev.txt ]; then
            uv pip install -r requirements-dev.txt
          fi

          # Install project dependencies
          if [ -f requirements.txt ]; then
            uv pip install -r requirements.txt
          fi

      - name: Create coverage directories
        run: |
          mkdir -p coverage
          mkdir -p junit

      - name: Run tests with coverage
        env:
          PYTHONPATH: ${{ github.workspace }}
        run: |
          # Activate virtual environment
          source .venv/bin/activate

          # Run tests with pytest and coverage
          pytest tests/ \
            -n auto \
            -v \
            --import-mode=importlib \
            --cov=. \
            --cov-report=xml \
            --cov-report=term-missing \
            --cov-report=html:coverage/html \
            --cov-fail-under=15 \
            --junitxml=junit/test-results.xml \
            --tb=short

      - name: Generate coverage summary
        if: always()
        run: |
          # Activate virtual environment
          source .venv/bin/activate
          
          # Generate coverage summary
          if [ -f coverage.xml ]; then
            echo "Coverage report generated successfully"
            
            # Extract coverage percentage from XML using secure defusedxml
            python -c "
try:
    from defusedxml import ElementTree as ET
except ImportError:
    print('defusedxml not available, falling back to xml.etree.ElementTree')
    import xml.etree.ElementTree as ET
import sys
try:
    tree = ET.parse('coverage.xml')
    root = tree.getroot()
    coverage = root.attrib.get('line-rate', '0')
    coverage_percent = float(coverage) * 100
    print(f'Total coverage: {coverage_percent:.2f}%')
    
    # Check if coverage meets threshold
    if coverage_percent >= 15.0:
        print('✅ Coverage threshold (15%) met!')
        sys.exit(0)
    else:
        print('❌ Coverage threshold (15%) not met!')
        sys.exit(1)
except Exception as e:
    print(f'Error parsing coverage: {e}')
    sys.exit(1)
"
          else
            echo "❌ No coverage report found"
            exit 1
          fi

      - name: Upload coverage reports
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: python-coverage-report-${{ github.run_id }}
          path: |
            coverage.xml
            coverage/html/
            junit/test-results.xml
          retention-days: 7

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@v3
        if: always()
        with:
          file: ./coverage.xml
          flags: python
          name: python-coverage
          fail_ci_if_error: false

      - name: Comment coverage on PR
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            
            try {
              // Read coverage XML file
              const coverageXml = fs.readFileSync('coverage.xml', 'utf8');
              const match = coverageXml.match(/line-rate="([^"]+)"/);
              
              if (match) {
                const coverage = (parseFloat(match[1]) * 100).toFixed(2);
                const threshold = 15;
                const status = coverage >= threshold ? '✅' : '❌';
                
                const comment = `## ${status} Python Coverage Report
                
**Coverage:** ${coverage}%
**Threshold:** ${threshold}%
**Status:** ${coverage >= threshold ? 'PASSED' : 'FAILED'}

${coverage >= threshold ? 
  'Great job! Coverage threshold met.' : 
  'Coverage is below the required threshold. Please add more tests.'}
                `;
                
                github.rest.issues.createComment({
                  issue_number: context.issue.number,
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  body: comment
                });
              }
            } catch (error) {
              console.log('Could not read coverage file or post comment:', error);
            }
